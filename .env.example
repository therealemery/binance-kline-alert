# ============================================================
# 币安 K 线监控企业微信 Bot 环境变量示例
# 复制为 .env 并填入真实凭证（.env 已加入 .gitignore，请勿提交到 Git）
# ============================================================

# [可选 / 自然语言设形态与对话路由] DeepSeek API Key（兼容任意 OpenAI 格式接口）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# [推荐] 企业微信内部群机器人 Webhook 地址（用于稳定推送告警，无 24h 会话限制）
# 支持逗号分隔配置多个群 Webhook
WECOM_WEBHOOK_URL=

# [可选] 企业微信智能机器人长连接凭证（用于群内 @机器人 自然语言交互，无需公网域名）
# 在企业微信管理后台 -> 智能机器人 -> API 模式（长连接）获取
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# [推荐 / 国际团队] Telegram Bot 凭证（找 @BotFather 执行 /newbot 获取）
# 支持纯 Telegram / 纯企微 / 双通道并行，零新增依赖，无需公网域名
TELEGRAM_BOT_TOKEN=
# 固定推送目标 chat_id，支持逗号分隔（群聊通常为 -100... 开头的负数，留空则自动推送给已交互的会话）
TELEGRAM_CHAT_IDS=
# 可选：Telegram 专用代理，留空时自动回退使用 BINANCE_PROXY
TELEGRAM_PROXY=

# [可选] 访问币安 API 的代理（海外服务器留空直连即可；国内环境可填 http://127.0.0.1:7890 或 socks5://...）
BINANCE_PROXY=
